{
	"servers": {
		"maitabi": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"phonhay103/maitabi-mcp-server:latest"
			],
			"type": "stdio"
		},
		"maitabi-pypi": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"maitabi-mcp-server"
			]
		},
		"maitabi-uvx-local": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				".",
				"maitabi-mcp-server"
			]
		},
		"maitabi-docker-local": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"maitabi-mcp-server:latest"
			]
		}
	},
	"inputs": []
}